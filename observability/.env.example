# Observability Environment Overrides
# Copy to .env or set in your environment as needed

OBSERVABILITY_NET=personal-lifecycle-observability-net

# Host Port Mappings (configured to avoid collisions with other projects)
OTEL_GRPC_PORT=4327
OTEL_HTTP_PORT=4328
OTEL_METRICS_PORT=8899
PROMETHEUS_PORT=9091
LOKI_PORT=3101
TEMPO_PORT=3201
GRAFANA_PORT=3004

# Container Names
OTEL_COLLECTOR_CONTAINER_NAME=personal-lifecycle-otel-collector
PROMETHEUS_CONTAINER_NAME=personal-lifecycle-prometheus
LOKI_CONTAINER_NAME=personal-lifecycle-loki
TEMPO_CONTAINER_NAME=personal-lifecycle-tempo
GRAFANA_CONTAINER_NAME=personal-lifecycle-grafana

# Grafana Credentials
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
